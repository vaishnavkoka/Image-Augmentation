# Copy to backend/.env and edit. setup.sh does the copy for you.

# --- Flask ------------------------------------------------------------------
# DEBUG=True turns on the Werkzeug debugger, which exposes /console -- a remote
# Python execution endpoint. It defaults to off here so a fresh install is safe.
# app.py additionally refuses to enable it when bound off-loopback, but do not
# rely on that: leave it False for anything other than local development.
FLASK_ENV=production
DEBUG=False
LOG_LEVEL=INFO

# --- Ports ------------------------------------------------------------------
# run.sh, doctor.py and the UI all read these, so changing them here is enough.
# Worth changing FLASK_PORT on macOS, where AirPlay Receiver holds 5000.
FLASK_PORT=5000
FRONTEND_PORT=3000

# --- Storage ----------------------------------------------------------------
# Relative to the backend/ directory.
UPLOAD_FOLDER=../../uploads
OUTPUT_FOLDER=../../outputs
# Upload size cap in bytes. 0 (or unset) means no limit.
MAX_FILE_SIZE=0

# --- ImageMagick ------------------------------------------------------------
# Which ImageMagick to bind to.
#
# Leave unset to use whatever the system provides. Set it if the system build
# is missing the png/tiff/webp/freetype delegates -- without them those formats
# silently fall back to Pillow, which only approximates the ImageMagick
# operators. DOCUMENTATION.md section 3 covers building one without root.
#
# MAGICK_HOME=/home/youruser/opt/imagemagick-7-full

# Profiles come from assets/icc only, so the catalogue is identical on every
# machine. Set this to true to also scan the host's colour directories -- handy
# for exploring, but it makes the number of profiles machine-dependent.
PROFILE_SCAN_SYSTEM=false

# --- Output -----------------------------------------------------------------
# JPEG output quality, 1-100. JPEG is re-encoded on the way out, so a lower
# value adds compression loss on top of the filter. 100 minimises it.
JPEG_QUALITY=90
